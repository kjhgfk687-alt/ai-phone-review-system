# ==== AI手机参数提取与评测系统 配置 ====
# 复制本文件为 .env 并填入你自己的 Key（.env 已被 gitignore，不会提交）

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-你的Key

# 评测生成专用 Key（可选，留空则与上面共用）
DEEPSEEK_REVIEW_API_KEY=

# 本地 Jina Reader 地址（按实际部署修改）
JINA_READER_URL=http://127.0.0.1:3001/

# 模型名称
DEEPSEEK_MODEL=deepseek-v4-flash

# 分段并行提取的并发数（过大可能触发限流）
MAX_PARALLEL_CHUNKS=4

# 多部手机URL同时提取的并发数
MAX_PARALLEL_URLS=3

# 评测/建议/对比的后台生成并发数
MAX_PARALLEL_GENERATIONS=3

# 评测类文本生成关闭模型思考（实测更快，质量由结构化摘要保证）；设为 0 恢复思考
DISABLE_THINKING=1

# API 调用失败重试次数
API_MAX_RETRIES=3

# 开发者选项访问密码（界面侧边栏）
DEV_PASSWORD=shumaceping
